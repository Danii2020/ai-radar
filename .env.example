# AI Radar — configuration.
# Copy to `.env` and adjust. Credentials are read from ~/.aws by default,
# so you usually only need this file to override the region or models.

AWS_REGION=us-east-1

# Bedrock models.
HAIKU_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0   # bulk summarization
# Bedrock unit prices (design §7), USD per 1M tokens, for HAIKU_MODEL_ID above
# (Spec 06: run-observability). Used to estimate curation-run cost.
# HAIKU_INPUT_USD_PER_1M=1.0
# HAIKU_OUTPUT_USD_PER_1M=5.0
# Chat model. Default below (Sonnet 4.5) is enabled. To use Sonnet 4.6, enable its
# model access in the Bedrock console, then uncomment the 4.6 line.
SONNET_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# SONNET_MODEL_ID=us.anthropic.claude-sonnet-4-6
EMBED_MODEL_ID=amazon.titan-embed-text-v2:0                  # RAG embeddings
EMBED_DIM=256

# Run tuning.
AI_RADAR_MAX_ITEMS=8      # max items to summarize per run (cost control)
AI_RADAR_PER_FEED=5       # max recent entries pulled from each feed
AI_RADAR_TOP_K=4          # cards retrieved as grounding per chat turn

# Only needed if you are NOT using the shared ~/.aws credentials file:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Tavily web search (curation-plane discovery). Local-only key resolution —
# get a key at https://tavily.com; Secrets Manager resolution is deferred
# to a later phase (runtime-packaging).
TAVILY_API_KEY=

# Tavily discovery tuning (all optional; defaults live in src/curation/config.py).
# CURATION_TAVILY_SEEDS=seed one;seed two
# CURATION_TAVILY_RESULTS_PER_QUERY=5
# CURATION_TAVILY_MAX_RESULTS=20
# CURATION_TAVILY_DAYS=7
# CURATION_TAVILY_SEARCH_DEPTH=basic
# CURATION_TAVILY_TOPIC=general
# CURATION_TAVILY_INCLUDE_DOMAINS=
# CURATION_TAVILY_EXCLUDE_DOMAINS=

# Run observability (Spec 06: run-observability) — cost estimation + CloudWatch
# EMF metrics. Tavily credit price is an ESTIMATE (Tavily's API does not report
# consumption); the metric namespace and kill switch default to on.
# CURATION_TAVILY_CREDIT_PRICE_USD=0.008
# CURATION_METRIC_NAMESPACE=AIRadar/Curation
# CURATION_EMIT_METRICS accepts true/false/1/0/yes/no/on/off (case-insensitive);
# an unparseable value (e.g. "yolo") is now a startup error (pydantic-settings-config).
# CURATION_EMIT_METRICS=true

# DynamoDB card store (Spec 03: dynamodb-card-store). Store selector for the
# local entrypoint: "json" (default, .ai_radar_cache/ files) | "dynamo" (real
# DynamoDB table, requires a deployed CardStoreTable + AWS creds).
CARD_STORE_BACKEND=json
CARD_TABLE_NAME=ai-radar-cards

# AgentCore Runtime entrypoint (Spec 04: runtime-packaging). The deployed
# agent (`runtime_app.py`) resolves the Tavily API key from AWS Secrets
# Manager AT INVOCATION TIME using this secret NAME — the key VALUE is never
# read from this file, baked into the container image, or set as a build-time
# env var in the Runtime. Local `run_curation.py` is unaffected: it keeps
# using TAVILY_API_KEY above. Falls back to RSS-only discovery if the secret
# is missing/unreadable.
TAVILY_SECRET_NAME=ai-radar/tavily-api-key

# Feed read API (Phase 2, spec `feed-api`). Only CARD_TABLE_NAME is set on the
# deployed Lambda; the page-size bounds are here for local/test overrides.
# FEED_API_DEFAULT_PAGE_SIZE=20
# FEED_API_MAX_PAGE_SIZE=100
