[
  {
    "id": "ruff",
    "kind": "lint",
    "argv": [
      "uv",
      "run",
      "ruff",
      "check"
    ],
    "pathMode": "per-file",
    "extensions": [
      ".py",
      ".pyi"
    ],
    "requires": {
      "binary": "uv"
    }
  },
  {
    "id": "mypy",
    "kind": "typecheck",
    "argv": [
      "uv",
      "run",
      "mypy"
    ],
    "pathMode": "per-file",
    "extensions": [
      ".py",
      ".pyi"
    ],
    "requires": {
      "binary": "uv"
    }
  }
]
