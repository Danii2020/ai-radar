{
  "version": 1,
  "specs": {
    "dir": "specs",
    "reservedDirs": [
      "current",
      "archived"
    ],
    "schemaFiles": [
      "intent",
      "execution-plan",
      "tasks"
    ],
    "legacySchemaFiles": [
      "intent",
      "contract",
      "roadmap",
      "tasks",
      "audit"
    ],
    "shippedMarker": "Shipped:",
    "approvedVerdicts": [
      "APPROVED WITH RESERVATIONS",
      "APPROVED"
    ]
  },
  "require": [
    {
      "id": "conventions-doc",
      "description": "a conventions document (AGENTS.md or CLAUDE.md) exists",
      "anyOf": [
        "AGENTS.md",
        "CLAUDE.md"
      ],
      "remediation": "add an AGENTS.md (or CLAUDE.md) documenting this repo's conventions"
    },
    {
      "id": "harness-manifest",
      "description": ".sdd/harness.json exists",
      "anyOf": [
        ".sdd/harness.json"
      ],
      "remediation": "run npx harny init to scaffold .sdd/harness.json"
    },
    {
      "id": "spec-schema:intent",
      "description": ".sdd/spec-schema/intent.md exists",
      "anyOf": [
        ".sdd/spec-schema/intent.md"
      ],
      "remediation": "run npx harny init to scaffold .sdd/spec-schema/intent.md",
      "requires": {
        "anyFile": [
          ".sdd/harness.json"
        ]
      }
    },
    {
      "id": "spec-schema:execution-plan",
      "description": ".sdd/spec-schema/execution-plan.md exists",
      "anyOf": [
        ".sdd/spec-schema/execution-plan.md"
      ],
      "remediation": "run npx harny init to scaffold .sdd/spec-schema/execution-plan.md",
      "requires": {
        "anyFile": [
          ".sdd/harness.json"
        ]
      }
    },
    {
      "id": "spec-schema:tasks",
      "description": ".sdd/spec-schema/tasks.md exists",
      "anyOf": [
        ".sdd/spec-schema/tasks.md"
      ],
      "remediation": "run npx harny init to scaffold .sdd/spec-schema/tasks.md",
      "requires": {
        "anyFile": [
          ".sdd/harness.json"
        ]
      }
    },
    {
      "id": "spec-schema:audit",
      "description": ".sdd/spec-schema/audit.md exists",
      "anyOf": [
        ".sdd/spec-schema/audit.md"
      ],
      "remediation": "run npx harny init to scaffold .sdd/spec-schema/audit.md",
      "requires": {
        "anyFile": [
          ".sdd/harness.json"
        ]
      }
    },
    {
      "id": "feedback-runner",
      "description": ".sdd/feedback/run-feedback.mjs is scaffolded",
      "anyOf": [
        ".sdd/feedback/run-feedback.mjs"
      ],
      "remediation": "run npx harny init and commit .sdd/feedback/run-feedback.mjs",
      "requires": {
        "anyFile": [
          ".sdd/harness.json"
        ]
      }
    },
    {
      "id": "ci-workflow",
      "description": "../../.github/workflows/harny-feedback-apps-web.yml is scaffolded",
      "anyOf": [
        "../../.github/workflows/harny-feedback-apps-web.yml"
      ],
      "remediation": "run npx harny init and commit ../../.github/workflows/harny-feedback-apps-web.yml",
      "requires": {
        "anyFile": [
          ".sdd/harness.json"
        ]
      }
    },
    {
      "id": "conductor:.claude/skills/sdd-conductor/SKILL.md",
      "description": ".claude/skills/sdd-conductor/SKILL.md exists",
      "anyOf": [
        ".claude/skills/sdd-conductor/SKILL.md"
      ],
      "remediation": "run npx harny init and commit .claude/skills/sdd-conductor/SKILL.md",
      "requires": {
        "anyFile": [
          ".sdd/harness.json"
        ]
      }
    },
    {
      "id": "core-skills:.claude/skills/harny-propose",
      "description": ".claude/skills/harny-propose/SKILL.md exists",
      "anyOf": [
        ".claude/skills/harny-propose/SKILL.md"
      ],
      "remediation": "run npx harny init and commit .claude/skills/harny-propose/SKILL.md"
    },
    {
      "id": "core-skills:.claude/skills/harny-test",
      "description": ".claude/skills/harny-test/SKILL.md exists",
      "anyOf": [
        ".claude/skills/harny-test/SKILL.md"
      ],
      "remediation": "run npx harny init and commit .claude/skills/harny-test/SKILL.md"
    },
    {
      "id": "core-skills:.claude/skills/harny-implement",
      "description": ".claude/skills/harny-implement/SKILL.md exists",
      "anyOf": [
        ".claude/skills/harny-implement/SKILL.md"
      ],
      "remediation": "run npx harny init and commit .claude/skills/harny-implement/SKILL.md"
    },
    {
      "id": "core-skills:.claude/skills/harny-audit",
      "description": ".claude/skills/harny-audit/SKILL.md exists",
      "anyOf": [
        ".claude/skills/harny-audit/SKILL.md"
      ],
      "remediation": "run npx harny init and commit .claude/skills/harny-audit/SKILL.md"
    },
    {
      "id": "core-skills:.claude/skills/harny-document",
      "description": ".claude/skills/harny-document/SKILL.md exists",
      "anyOf": [
        ".claude/skills/harny-document/SKILL.md"
      ],
      "remediation": "run npx harny init and commit .claude/skills/harny-document/SKILL.md"
    },
    {
      "id": "core-skills:.claude/skills/harny-sync",
      "description": ".claude/skills/harny-sync/SKILL.md exists",
      "anyOf": [
        ".claude/skills/harny-sync/SKILL.md"
      ],
      "remediation": "run npx harny init and commit .claude/skills/harny-sync/SKILL.md"
    },
    {
      "id": "core-skills:.claude/skills/harny-feedback",
      "description": ".claude/skills/harny-feedback/SKILL.md exists",
      "anyOf": [
        ".claude/skills/harny-feedback/SKILL.md"
      ],
      "remediation": "run npx harny init and commit .claude/skills/harny-feedback/SKILL.md"
    },
    {
      "id": "core-skills:.claude/skills/harny-doctor",
      "description": ".claude/skills/harny-doctor/SKILL.md exists",
      "anyOf": [
        ".claude/skills/harny-doctor/SKILL.md"
      ],
      "remediation": "run npx harny init and commit .claude/skills/harny-doctor/SKILL.md"
    },
    {
      "id": "knowledge-base",
      "description": "specs/current/_index.md exists",
      "anyOf": [
        "specs/current/_index.md"
      ],
      "remediation": "create specs/current/_index.md (see harny-sync)",
      "requires": {
        "anyFile": [
          "specs/current"
        ]
      }
    }
  ],
  "repoReadiness": [
    {
      "id": "repo-readiness:readme",
      "description": "a README exists",
      "anyOf": [
        "README.md"
      ],
      "remediation": "add a README.md describing what this project is and how to run it",
      "tier": "must-have"
    },
    {
      "id": "repo-readiness:architecture",
      "description": "an architecture or structure document exists",
      "anyOf": [
        "ARCHITECTURE.md",
        "AGENTS.md",
        "docs/architecture.md"
      ],
      "remediation": "add an ARCHITECTURE.md (or an AGENTS.md section) describing this repo's components and how they fit together",
      "tier": "recommended"
    },
    {
      "id": "repo-readiness:agent-guidance:CLAUDE.md",
      "description": "CLAUDE.md or AGENTS.md exists",
      "anyOf": [
        "CLAUDE.md",
        "AGENTS.md"
      ],
      "remediation": "add CLAUDE.md (or a root AGENTS.md) so this tool reads project guidance",
      "tier": "recommended",
      "requires": {
        "anyFile": [
          ".sdd/harness.json"
        ]
      }
    }
  ],
  "repoReadinessLabel": "repo readiness",
  "security": [
    {
      "id": "security:permissions-policy",
      "description": ".sdd/permissions/policy.json exists",
      "anyOf": [
        ".sdd/permissions/policy.json"
      ],
      "remediation": "run npx harny init to install the permissions baseline (.sdd/permissions/policy.json)",
      "tier": "recommended",
      "requires": {
        "anyFile": [
          ".sdd/harness.json"
        ]
      }
    },
    {
      "id": "security:permissions-guard",
      "description": ".sdd/permissions/run-guard.mjs exists",
      "anyOf": [
        ".sdd/permissions/run-guard.mjs"
      ],
      "remediation": "run npx harny init to install the permissions guard (.sdd/permissions/run-guard.mjs)",
      "tier": "recommended",
      "requires": {
        "anyFile": [
          ".sdd/harness.json"
        ]
      }
    },
    {
      "id": "security:permissions-wired:claude-code",
      "description": "Claude Code's hook config (.claude/settings.json) calls the permissions guard",
      "anyOf": [],
      "assert": {
        "kind": "fileContains",
        "path": ".claude/settings.json",
        "text": "run-guard.mjs"
      },
      "remediation": "run npx harny init --tools claude-code to wire the permissions guard into .claude/settings.json",
      "tier": "recommended",
      "requires": {
        "anyFile": [
          ".sdd/harness.json"
        ]
      }
    },
    {
      "id": "security:env-ignored",
      "description": "git ignores .env and .env.local",
      "anyOf": [],
      "assert": {
        "kind": "gitIgnored",
        "paths": [
          ".env",
          ".env.local"
        ]
      },
      "remediation": "add \".env*\" (and \"!.env.example\") to .gitignore, and untrack any committed .env with git rm --cached",
      "tier": "recommended"
    },
    {
      "id": "security:git-hooks",
      "description": "the commit-check hooks exist in .sdd/git-hooks",
      "anyOf": [
        ".sdd/git-hooks/pre-commit"
      ],
      "remediation": "run npx harny init to install the commit-check hooks (.sdd/git-hooks)",
      "tier": "recommended",
      "requires": {
        "anyFile": [
          ".sdd/harness.json"
        ]
      }
    },
    {
      "id": "security:git-hooks-active",
      "description": "core.hooksPath points at apps/web/.sdd/git-hooks",
      "anyOf": [],
      "assert": {
        "kind": "gitConfig",
        "key": "core.hooksPath",
        "equals": "apps/web/.sdd/git-hooks"
      },
      "remediation": "run git config core.hooksPath apps/web/.sdd/git-hooks (or, with a hook manager such as husky or lefthook, call apps/web/.sdd/git-hooks/pre-commit and pre-push from it)",
      "tier": "recommended",
      "requires": {
        "anyFile": [
          ".sdd/harness.json"
        ]
      }
    },
    {
      "id": "security:gitleaks",
      "description": "gitleaks is installed, so pre-commit scans staged changes for secrets",
      "anyOf": [],
      "assert": {
        "kind": "probe",
        "probe": {
          "binary": "gitleaks"
        }
      },
      "remediation": "install gitleaks (https://github.com/gitleaks/gitleaks#installing); CI still scans without it",
      "tier": "recommended"
    },
    {
      "id": "security:ci-secret-scan",
      "description": "the CI workflow runs the \"Secret scan (gitleaks)\" step",
      "anyOf": [],
      "assert": {
        "kind": "fileContains",
        "path": "../../.github/workflows/harny-feedback-apps-web.yml",
        "text": "Secret scan (gitleaks)"
      },
      "remediation": "run npx harny init to regenerate the CI workflow with the secret-scan step",
      "tier": "recommended",
      "requires": {
        "anyFile": [
          ".sdd/harness.json"
        ]
      }
    }
  ],
  "securityLabel": "security",
  "componentDocs": {
    "discovery": {
      "manifests": [
        "package.json",
        "pyproject.toml",
        "go.mod",
        "Cargo.toml",
        "pom.xml",
        "build.gradle",
        "build.gradle.kts",
        "Gemfile",
        "composer.json"
      ],
      "sourceRoots": [
        "src",
        "lib",
        "app"
      ],
      "ignore": [
        "node_modules",
        "dist",
        "build",
        "out",
        "coverage",
        "vendor",
        "target",
        "venv",
        "__pycache__",
        "fixtures"
      ],
      "maxDepth": 3,
      "minFiles": 3,
      "declared": [
        "."
      ]
    },
    "docName": "AGENTS.md",
    "bridges": [
      {
        "tool": "claude-code",
        "path": "{dir}/CLAUDE.md",
        "contents": "@AGENTS.md\n",
        "marker": "@AGENTS.md"
      }
    ]
  },
  "commands": [
    {
      "id": "npm-test",
      "kind": "test",
      "argv": [
        "npm",
        "test"
      ],
      "pathMode": "whole-project",
      "requires": {
        "script": "test"
      }
    }
  ]
}
