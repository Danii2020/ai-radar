# Base URL of the deployed feed-api (Phase 2, spec `feed-api`) — NO trailing
# slash, NO path. The app appends /v1/cards itself.
#
# SERVER-ONLY on purpose (AD-4): every fetch happens in a Server Component, so
# this must NOT be prefixed NEXT_PUBLIC_ and must never be read from a
# "use client" module.
#
# Local dev: copy to .env.local (gitignored) and keep this value.
# Vercel: set the same key in Project Settings -> Environment Variables.
FEED_API_BASE_URL=https://25p45q6m6f.execute-api.us-east-1.amazonaws.com

# --- Chat (spec `web-chat-ui`) -------------------------------------------------
# Base URL of the deployed chat API, NO trailing slash, NO path. The server appends
# /v1/chat itself. Placeholder only: put the real value in .env.local (gitignored) or in
# the Vercel project settings.
#
# SERVER-ONLY: never prefix these NEXT_PUBLIC_ and never read them from a "use client"
# module. Do not use the names AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (Vercel reserves
# them). The key belongs to the IAM user ai-radar-chat-api-caller; rotation and leak steps
# are in docs/runbooks.md at the repo root, "Chat API caller key".
CHAT_API_BASE_URL=https://<api-id>.execute-api.us-east-1.amazonaws.com
CHAT_API_ACCESS_KEY_ID=<access-key-id>
CHAT_API_SECRET_ACCESS_KEY=<secret-access-key>
