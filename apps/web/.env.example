# Base URL of the deployed feed-api (Phase 2, spec `feed-api`) — NO trailing
# slash, NO path. The app appends /v1/cards itself.
#
# SERVER-ONLY on purpose (AD-4): every fetch happens in a Server Component, so
# this must NOT be prefixed NEXT_PUBLIC_ and must never be read from a
# "use client" module.
#
# Local dev: copy to .env.local (gitignored) and keep this value.
# Vercel: set the same key in Project Settings -> Environment Variables.
FEED_API_BASE_URL=https://25p45q6m6f.execute-api.us-east-1.amazonaws.com

# --- Chat (spec `web-chat-ui`) -------------------------------------------------
# Base URL of the deployed chat API, NO trailing slash, NO path. The server appends
# /v1/chat itself. Placeholder only: put the real value in .env.local (gitignored) or in
# the Vercel project settings.
#
# SERVER-ONLY: never prefix these NEXT_PUBLIC_ and never read them from a "use client"
# module. Do not use the names AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (Vercel reserves
# them). The key belongs to the IAM user ai-radar-chat-api-caller; rotation and leak steps
# are in docs/runbooks.md at the repo root, "Chat API caller key".
CHAT_API_BASE_URL=https://<api-id>.execute-api.us-east-1.amazonaws.com
CHAT_API_ACCESS_KEY_ID=<access-key-id>
CHAT_API_SECRET_ACCESS_KEY=<secret-access-key>

# --- Chat visitor limit (spec `web-chat-visitor-rate-limit`) -------------------------------
# Per-visitor and global turn limits on POST /api/chat, counted in Upstash Redis over its REST API.
# All SERVER-ONLY, never NEXT_PUBLIC_, never logged. Unset limits use the defaults shown.
#
# Production (Vercel): connect an Upstash Redis database from the Vercel Marketplace to the project;
# it injects KV_REST_API_URL and KV_REST_API_TOKEN (UPSTASH_REDIS_REST_URL / _TOKEN are read as
# well). Do not copy them into .env.local: off Vercel the limiter uses an in-process store and needs
# no variable at all. The salt is required whenever the Upstash store is used.
# CHAT_RATE_LIMIT_SALT=<random value of at least 32 characters, generated locally, never pasted in chat>
# KV_REST_API_URL=<set by the Vercel Marketplace integration>
# KV_REST_API_TOKEN=<set by the Vercel Marketplace integration>
#
# Optional overrides (whole numbers):
# CHAT_RATE_LIMIT_BURST=5            # turns per visitor per burst window
# CHAT_RATE_LIMIT_BURST_WINDOW_S=60  # burst window length in seconds
# CHAT_RATE_LIMIT_DAILY=20           # turns per visitor per UTC day
# CHAT_RATE_LIMIT_GLOBAL_DAILY=50    # turns for all visitors together per UTC day
# CHAT_RATE_LIMIT_STORE=memory|upstash   # default: upstash on Vercel or when a REST URL is set, else memory

# --- Chat response cache (spec `web-chat-response-cache`) ---------------------------------
# First-turn answers are kept for a while in the same store as the visitor limiter (Upstash on Vercel,
# in-process locally), so a repeated question makes no backend call. SERVER-ONLY. A cache problem never
# fails a request: it is treated as a miss.
# CHAT_CACHE_TTL_S=21600   # seconds an answer is kept (60 to 86400); 0 turns the cache off
